{
  "name": "puneet-2",
  "displayName": "Puneet 3.0",
  "description": "A local-only VS Code coding-agent workbench powered by the documented OpenAI Codex app-server.",
  "version": "3.6.0",
  "publisher": "local",
  "author": {
    "name": "Puneet Garg"
  },
  "license": "MIT",
  "icon": "media/puneet-2-icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:puneet2.chat",
    "onCommand:puneet2.open"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Puneet 3.0 can run commands and edit files, so the workspace must be trusted."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "contributes": {
    "commands": [
      {
        "command": "puneet2.open",
        "title": "Puneet 3.0: Open Sidebar",
        "icon": "$(sparkle)"
      },
      {
        "command": "puneet2.newChat",
        "title": "Puneet 3.0: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "puneet2.showHistory",
        "title": "Puneet 3.0: Previous Chats",
        "icon": "$(history)"
      },
      {
        "command": "puneet2.openPlans",
        "title": "Puneet 3.0: Open Plans Folder",
        "icon": "$(markdown)"
      },
      {
        "command": "puneet2.openTads",
        "title": "Puneet 3.0: Open TADs Folder",
        "icon": "$(book)"
      },
      {
        "command": "puneet2.openCommandMenu",
        "title": "Puneet 3.0: Open Command Menu",
        "icon": "$(terminal)"
      },
      {
        "command": "puneet2.addSelection",
        "title": "Puneet 3.0: Add Selection to Chat"
      },
      {
        "command": "puneet2.addFile",
        "title": "Puneet 3.0: Add Active File to Chat"
      },
      {
        "command": "puneet2.login",
        "title": "Puneet 3.0: Sign In"
      },
      {
        "command": "puneet2.logout",
        "title": "Puneet 3.0: Sign Out"
      },
      {
        "command": "puneet2.stop",
        "title": "Puneet 3.0: Stop Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "puneet2.reviewChanges",
        "title": "Puneet 3.0: Review Uncommitted Changes"
      },
      {
        "command": "puneet2.reviewPendingChanges",
        "title": "Puneet 3.0: Review Pending Edits Inline"
      },
      {
        "command": "puneet2.acceptFileChange",
        "title": "Puneet 3.0: Keep Edits in This File",
        "icon": "$(check-all)"
      },
      {
        "command": "puneet2.rejectFileChange",
        "title": "Puneet 3.0: Undo Edits in This File",
        "icon": "$(discard)"
      },
      {
        "command": "puneet2.acceptAllChanges",
        "title": "Puneet 3.0: Keep All Pending Edits"
      },
      {
        "command": "puneet2.showStatus",
        "title": "Puneet 3.0: Show Account and Usage"
      },
      {
        "command": "puneet2.openSettings",
        "title": "Puneet 3.0: Open Settings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "puneet2",
          "title": "Puneet 3.0",
          "icon": "media/codex-agent.svg"
        }
      ]
    },
    "views": {
      "puneet2": [
        {
          "type": "webview",
          "id": "puneet2.chat",
          "name": "Agent"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "puneet2.showHistory",
          "when": "view == puneet2.chat",
          "group": "navigation@1"
        },
        {
          "command": "puneet2.newChat",
          "when": "view == puneet2.chat",
          "group": "navigation@2"
        },
        {
          "command": "puneet2.openCommandMenu",
          "when": "view == puneet2.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "puneet2.acceptFileChange",
          "when": "puneet2.activeFileHasPendingChanges",
          "group": "navigation@1"
        },
        {
          "command": "puneet2.rejectFileChange",
          "when": "puneet2.activeFileCanReject",
          "group": "navigation@2"
        },
        {
          "command": "puneet2.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@50"
        },
        {
          "command": "puneet2.addFile",
          "group": "navigation@51"
        }
      ],
      "editor/title": [
        {
          "command": "puneet2.acceptFileChange",
          "when": "puneet2.activeFileHasPendingChanges",
          "group": "navigation@1"
        },
        {
          "command": "puneet2.rejectFileChange",
          "when": "puneet2.activeFileCanReject",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Puneet 3.0",
      "properties": {
        "puneet2.cliExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Codex CLI executable. Leave empty to auto-detect it."
        },
        "puneet2.model": {
          "type": "string",
          "default": "",
          "description": "Default Codex model. Leave empty to use the server-selected default."
        },
        "puneet2.reasoningEffort": {
          "type": "string",
          "default": "",
          "description": "Optional reasoning effort sent with each turn (for example low, medium, high, or xhigh)."
        },
        "puneet2.planDirectory": {
          "type": "string",
          "default": ".puneet/plans",
          "description": "Workspace-relative directory where completed Plan-mode responses are saved as Markdown files."
        },
        "puneet2.tadDirectory": {
          "type": "string",
          "default": ".puneet/tads",
          "description": "Workspace-relative directory where completed TAD-mode responses are saved as Markdown files."
        },
        "puneet2.sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumDescriptions": [
            "Allow inspection only.",
            "Allow edits within the active workspace.",
            "Disable the filesystem sandbox. Use only in controlled environments."
          ],
          "default": "workspace-write",
          "description": "Filesystem sandbox applied to new Codex threads."
        },
        "puneet2.approvalPolicy": {
          "type": "string",
          "enum": [
            "on-request",
            "untrusted",
            "never"
          ],
          "enumDescriptions": [
            "Ask when Codex needs elevated access.",
            "Require approval for commands not covered by trusted rules.",
            "Never display approval prompts."
          ],
          "default": "on-request",
          "description": "Approval policy applied to new Codex threads."
        },
        "puneet2.inlineReview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight Codex changes in the existing editor, show compact per-hunk Undo/Keep actions above each changed block, and reveal the before/after diff on hover."
        },
        "puneet2.selectionAction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show an Add to Chat action above selected code in the active editor."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "1.100.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
